<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- build.ps1 sets TfmOverride to match whichever SDK you have installed (net10.0-windows, net11.0-windows, ...) -->
    <TargetFramework>net11.0-windows</TargetFramework>
    <TargetFramework Condition="'$(TfmOverride)' != ''">$(TfmOverride)</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HtmlScreensaver</AssemblyName>
    <RootNamespace>HtmlScreensaver</RootNamespace>
    <Version>1.0.0</Version>
    <Product>HTML Screensaver</Product>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- drawn by make-icon.py; shown on the setup exe, the .scr, the installer window and Installed apps -->
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- Keep the output lean -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The only third-party dependency. Floats to the newest stable 1.0.x at restore time. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- The repo's scenes are bundled into the exe; the installer unpacks them next to the installed .scr -->
    <EmbeddedResource Include="..\..\scenes\**\*" LogicalName="scenes\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
